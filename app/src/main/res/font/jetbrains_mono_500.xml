<?xml version="1.0" encoding="utf-8"?>
<!--
    One instance pinned out of a variable font. Android needs a concrete
    weight per resource, so the axis value is frozen here rather than at the
    Compose call site; requires API 26, which is our minSdk.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/jetbrains_mono_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
</font-family>
